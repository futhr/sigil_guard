[
  verbose: false,
  private: false,
  skip: true,
  # Non-Phoenix library: use this Elixir-readable config file to satisfy
  # Sobelow's router input without adding a fake runtime router module.
  router: ".sobelow-conf",
  exit: "low",
  format: "txt",
  ignore: ["Config.HTTPS"],
  ignore_files: []
]
